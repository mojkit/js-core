# Mojkit Configuration

# Path to the Mojkit config file (default: mojkit.config.ts in cwd)
# MOJKIT_CONFIG_PATH=mojkit.config.ts

# Override server host via environment (maps to server.host)
# MOJKIT_CONFIG_SERVER_HOST=0.0.0.0

# Override server port via environment (maps to server.port)
# MOJKIT_CONFIG_SERVER_PORT=7000

# Override service name via environment (maps to service.name)
# MOJKIT_CONFIG_SERVICE_NAME=mojkit-service

# Override runtime environment via environment (maps to service.environment)
# MOJKIT_CONFIG_SERVICE_ENVIRONMENT=development

# RabbitMQ

# Full RabbitMQ connection URL
# Format: amqp://<user>:<password>@<host>:<port>/<vhost>
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Number of unacknowledged messages to prefetch per consumer (default: 2)
# RABBITMQ_PREFETCH_COUNT=2
